#!/usr/bin/env bash
# wechat-use — command launcher installed by install.sh as $INSTALL_DIR/wechat-use.
#
# The real CLI is the `wechat` binary next to this file. This launcher adds the
# *-use family upgrade convention (https://github.com/leeguooooo/plugins/blob/main/docs/upgrade.md):
#   wechat-use upgrade [--check] [--json]
#   a once-a-day "new version" notice on stderr
# and hands every other invocation to `wechat` unchanged (exec, same args,
# same stdin/stdout/exit code). `wechat update-guard` (WeChat's own auto-update
# lock) is a separate command and is not touched here.
#
# Opt out of the daily notice: CI, WECHAT_USE_NO_UPDATE_CHECK or USE_NO_UPDATE_CHECK.
set -u

WU_NAME="wechat-use"
WU_REPO="${WECHAT_USE_REPO:-leeguooooo/wechat-use}"
WU_API_URL="${WECHAT_USE_RELEASES_API:-https://api.github.com/repos/${WU_REPO}/releases/latest}"
WU_INSTALLER_URL="${WECHAT_USE_INSTALLER_URL:-https://raw.githubusercontent.com/${WU_REPO}/main/install.sh}"
WU_PLUGIN_ID="wechat-use@leeguooooo-plugins"
WU_CHECK_INTERVAL=86400

wu_self_dir() {
  local src="${BASH_SOURCE[0]}" dir
  while [[ -L "$src" ]]; do
    dir=$(cd -P "$(dirname "$src")" && pwd) || return 1
    src=$(readlink "$src")
    [[ "$src" == /* ]] || src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && pwd
}

WU_BIN="${WECHAT_USE_BIN:-$(wu_self_dir)/wechat}"

wu_cache_file() {
  printf '%s/%s/update-check.json\n' "${XDG_CACHE_HOME:-$HOME/.cache}" "$WU_NAME"
}

wu_now() { date +%s; }

# "wechat-use 1.18.12" -> 1.18.12
wu_current_version() {
  local out
  out=$("$WU_BIN" --version 2>/dev/null) || return 1
  out=${out##* }
  [[ -n "$out" ]] || return 1
  printf '%s\n' "${out#v}"
}

# 0 when $1 is a strictly newer X.Y.Z than $2. Leading "v" and any "-pre"/"+build"
# suffix are ignored; missing parts count as 0; non-numeric input is never newer.
wu_version_gt() {
  local a="${1#v}" b="${2#v}" i x y
  a=${a%%[-+]*}; b=${b%%[-+]*}
  [[ "$a" =~ ^[0-9]+(\.[0-9]+)*$ && "$b" =~ ^[0-9]+(\.[0-9]+)*$ ]] || return 1
  local -a pa pb
  IFS=. read -r -a pa <<<"$a"
  IFS=. read -r -a pb <<<"$b"
  for i in 0 1 2; do
    x=$((10#${pa[i]:-0})); y=$((10#${pb[i]:-0}))
    (( x > y )) && return 0
    (( x < y )) && return 1
  done
  return 1
}

# Newest non-prerelease release tag without the "v", or non-zero on any failure.
wu_fetch_latest() {
  local timeout="$1" body tag
  local -a headers=(-H 'Accept: application/vnd.github+json')
  [[ -n "${GITHUB_TOKEN:-}" ]] && headers+=(-H "Authorization: Bearer ${GITHUB_TOKEN}")
  body=$(curl -fsSL --connect-timeout "$timeout" --max-time "$timeout" "${headers[@]}" "$WU_API_URL" 2>/dev/null) || return 1
  tag=$(printf '%s\n' "$body" | sed -nE 's/^[[:space:]]*"tag_name"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/p' | head -n 1)
  tag=${tag#v}
  [[ "$tag" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  printf '%s\n' "$tag"
}

# Prints "<checked_at> <latest>" from the cache; latest may be empty.
wu_read_cache() {
  local file checked latest
  file=$(wu_cache_file)
  [[ -f "$file" ]] || return 1
  checked=$(sed -nE 's/.*"checked_at"[[:space:]]*:[[:space:]]*([0-9]+).*/\1/p' "$file" | head -n 1)
  latest=$(sed -nE 's/.*"latest"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/p' "$file" | head -n 1)
  [[ -n "$checked" ]] || return 1
  printf '%s %s\n' "$checked" "$latest"
}

wu_write_cache() {
  local checked="$1" latest="$2" file dir tmp
  file=$(wu_cache_file); dir=${file%/*}
  mkdir -p "$dir" 2>/dev/null || return 1
  tmp=$(mktemp "$dir/.update-check.XXXXXX" 2>/dev/null) || return 1
  if printf '{"checked_at": %s, "latest": "%s"}\n' "$checked" "$latest" >"$tmp" && mv -f "$tmp" "$file"; then
    return 0
  fi
  rm -f "$tmp"
  return 1
}

# One network check (2 s). A failure keeps the previous latest but still stamps
# checked_at, so an offline machine is not retried on every call.
wu_refresh_cache() {
  local previous="${1:-}" latest
  latest=$(wu_fetch_latest 2) || latest="$previous"
  wu_write_cache "$(wu_now)" "$latest"
}

wu_update_check_disabled() {
  [[ -n "${CI:-}" || -n "${WECHAT_USE_NO_UPDATE_CHECK:-}" || -n "${USE_NO_UPDATE_CHECK:-}" ]]
}

# upgrade, --version and --help (in any position) never check or notify.
wu_skip_for_args() {
  local arg
  [[ "${1:-}" == upgrade || "${1:-}" == help ]] && return 0
  for arg in "$@"; do
    [[ "$arg" == -- ]] && break
    case "$arg" in -V|--version|-h|--help) return 0 ;; esac
  done
  return 1
}

# Daily notice. Reads the cache (never waits on the network); a stale cache is
# refreshed in a detached background process whose result the next call shows.
wu_maybe_notice() {
  wu_update_check_disabled && return 0
  wu_skip_for_args "$@" && return 0
  local cached checked=0 latest="" current
  if cached=$(wu_read_cache); then
    checked=${cached%% *}; latest=${cached#* }
  fi
  if (( $(wu_now) - checked >= WU_CHECK_INTERVAL )); then
    if [[ -n "${WECHAT_USE_UPDATE_CHECK_SYNC:-}" ]]; then
      wu_refresh_cache "$latest"
      cached=$(wu_read_cache) && latest=${cached#* }
    else
      # Double fork: the refresher is re-parented to launchd, so it neither
      # holds this command's pipes open nor lingers as a zombie under `wechat`.
      ( wu_refresh_cache "$latest" </dev/null >/dev/null 2>&1 & )
    fi
  fi
  [[ -n "$latest" ]] || return 0
  current=$(wu_current_version) || return 0
  if wu_version_gt "$latest" "$current"; then
    printf '%s %s is available (you have %s). Upgrade: %s upgrade\n' "$WU_NAME" "$latest" "$current" "$WU_NAME" >&2
  fi
  return 0
}

# ---------- skill discovery (docs/upgrade.md section 3) ----------

WU_SKILLS=()  # entries: channel<TAB>path<TAB>update

wu_json_escape() {
  local s="$1"
  s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\t'/\\t}; s=${s//$'\n'/\\n}; s=${s//$'\r'/\\r}
  printf '%s' "$s"
}

wu_discover_skills() {
  WU_SKILLS=()
  local plugins="$HOME/.claude/plugins/installed_plugins.json" candidate real root seen=$'\n'
  if [[ -f "$plugins" ]] && grep -q "\"${WU_NAME}@" "$plugins" 2>/dev/null; then
    WU_SKILLS+=("claude-plugin"$'\t'"$plugins"$'\t'"claude plugin update ${WU_PLUGIN_ID}")
  fi
  for candidate in "$HOME/.agents/skills/$WU_NAME" "$HOME/.claude/skills/$WU_NAME" "$HOME/.codex/skills/$WU_NAME"; do
    [[ -d "$candidate" ]] || continue
    real=$(cd -P "$candidate" 2>/dev/null && pwd) || continue
    [[ "$seen" == *$'\n'"$real"$'\n'* ]] && continue
    seen+="$real"$'\n'
    root=$(git -C "$real" rev-parse --show-toplevel 2>/dev/null || true)
    # Only a checkout of the skill itself counts; never pull an enclosing repo
    # such as a dotfiles-managed $HOME.
    if [[ -n "$root" && "$(cd -P "$root" && pwd)" == "$real" ]]; then
      WU_SKILLS+=("git"$'\t'"$real"$'\t'"git -C $real pull --ff-only")
    elif [[ -f "$real/SKILL.md" ]]; then
      # wechat-use's installer owns copied skill folders (npx skills add):
      # the installer run by `wechat-use upgrade` refreshes them.
      WU_SKILLS+=("installer"$'\t'"$real"$'\t'"${WU_NAME} upgrade")
    fi
  done
}

wu_has_skill_channel() {
  local entry
  for entry in "${WU_SKILLS[@]+"${WU_SKILLS[@]}"}"; do
    [[ "${entry%%$'\t'*}" == "$1" ]] && return 0
  done
  return 1
}

wu_print_json() {
  local current="$1" latest="$2" available=false entry channel rest path update first=1
  wu_version_gt "$latest" "$current" && available=true
  printf '{\n  "name": "%s",\n  "current": "%s",\n  "latest": "%s",\n  "update_available": %s,\n  "skills": [' \
    "$WU_NAME" "$(wu_json_escape "$current")" "$(wu_json_escape "$latest")" "$available"
  for entry in "${WU_SKILLS[@]+"${WU_SKILLS[@]}"}"; do
    channel=${entry%%$'\t'*}; rest=${entry#*$'\t'}; path=${rest%%$'\t'*}; update=${rest#*$'\t'}
    [[ "$first" == 1 ]] && printf '\n' || printf ',\n'
    first=0
    printf '    {"channel": "%s", "path": "%s", "update": "%s"}' \
      "$(wu_json_escape "$channel")" "$(wu_json_escape "$path")" "$(wu_json_escape "$update")"
  done
  [[ "$first" == 1 ]] && printf ']\n}\n' || printf '\n  ]\n}\n'
}

wu_print_skills() {
  local entry channel rest path update
  for entry in "${WU_SKILLS[@]+"${WU_SKILLS[@]}"}"; do
    channel=${entry%%$'\t'*}; rest=${entry#*$'\t'}; path=${rest%%$'\t'*}; update=${rest#*$'\t'}
    printf 'skill (%s): %s — update: %s\n' "$channel" "$path" "$update"
  done
}

# Refresh plugin / git skills. Installer-managed folders are refreshed by the
# installer itself (WECHAT_USE_INSTALL_SKILL=yes), so only when it ran ($1=1).
wu_refresh_skills() {
  local installer_ran="${1:-0}" entry channel rest path failed=0
  for entry in "${WU_SKILLS[@]+"${WU_SKILLS[@]}"}"; do
    channel=${entry%%$'\t'*}; rest=${entry#*$'\t'}; path=${rest%%$'\t'*}
    case "$channel" in
      claude-plugin)
        if command -v claude >/dev/null 2>&1; then
          printf 'skill (claude-plugin): claude plugin update %s\n' "$WU_PLUGIN_ID"
          claude plugin update "$WU_PLUGIN_ID" || { printf 'skill (claude-plugin): update failed; run it yourself: claude plugin update %s\n' "$WU_PLUGIN_ID" >&2; failed=1; }
        else
          printf 'skill (claude-plugin): claude is not on PATH; run: claude plugin update %s\n' "$WU_PLUGIN_ID"
        fi ;;
      git)
        if git -C "$path" pull --ff-only; then
          printf 'skill (git): %s updated\n' "$path"
        else
          printf 'skill (git): %s not updated (local changes or diverged?); not forcing\n' "$path" >&2
          failed=1
        fi ;;
      installer)
        if [[ "$installer_ran" == 1 ]]; then
          printf 'skill (installer): %s refreshed by the installer\n' "$path"
        else
          # The CLI is current, so the installer did not run; copied folders
          # are not re-copied behind the user's back (docs/upgrade.md).
          printf 'skill (installer): %s not refreshed (CLI already current); to re-copy it: npx -y skills add %s -y -g\n' "$path" "$WU_REPO"
        fi ;;
    esac
  done
  return "$failed"
}

wu_upgrade_usage() {
  cat <<'EOF'
Usage: wechat-use upgrade [--check] [--json]

Upgrade the wechat-use CLI to the latest GitHub release through its installer,
then refresh the wechat-use skill (Claude Code plugin, git checkout, or the
installer-managed skill folder).

  --check   change nothing; print "wechat-use <current> -> <latest>" or "is up to date"
  --json    like --check, as JSON
  -h        this help

Exit codes: 0 success (upgraded, current, or a check that ran); 2 the check or download failed;
1 the upgrade did not finish: the installer stopped, or a skill could not be refreshed
(the messages above say which).
EOF
}

wu_upgrade() {
  local mode=upgrade arg current latest
  for arg in "$@"; do
    case "$arg" in
      --check) [[ "$mode" == json ]] || mode=check ;;
      --json) mode=json ;;
      -h|--help) wu_upgrade_usage; return 0 ;;
      *) printf 'wechat-use upgrade: unknown option %s\n' "$arg" >&2; wu_upgrade_usage >&2; return 2 ;;
    esac
  done
  if ! current=$(wu_current_version); then
    printf 'wechat-use upgrade: cannot run %s --version; reinstall with:\n  curl -fsSL %s | bash\n' "$WU_BIN" "$WU_INSTALLER_URL" >&2
    return 2
  fi
  if ! latest=$(wu_fetch_latest 10); then
    printf 'wechat-use upgrade: could not read the latest release from GitHub (%s)\n' "$WU_API_URL" >&2
    return 2
  fi
  wu_write_cache "$(wu_now)" "$latest" || true
  wu_discover_skills

  case "$mode" in
    json) wu_print_json "$current" "$latest"; return 0 ;;
    check)
      if wu_version_gt "$latest" "$current"; then
        printf '%s %s -> %s\n' "$WU_NAME" "$current" "$latest"
      else
        printf '%s %s is up to date\n' "$WU_NAME" "$current"
      fi
      wu_print_skills
      return 0 ;;
  esac

  if ! wu_version_gt "$latest" "$current"; then
    printf '%s %s is up to date\n' "$WU_NAME" "$current"
    wu_refresh_skills 0 || return 1
    return 0
  fi

  printf '%s %s -> %s: running the installer\n' "$WU_NAME" "$current" "$latest"
  local stage installer status=0 skill_choice=no install_dir
  stage=$(mktemp -d "${TMPDIR:-/tmp}/wechat-use-upgrade.XXXXXX") || return 2
  installer="$stage/install.sh"
  if ! curl -fsSL --connect-timeout 20 --max-time 120 --proto '=https' --proto-redir '=https' \
      "$WU_INSTALLER_URL" -o "$installer" || ! bash -n "$installer" 2>/dev/null; then
    rm -rf -- "$stage"
    printf 'wechat-use upgrade: could not download the installer (%s)\n' "$WU_INSTALLER_URL" >&2
    return 2
  fi
  wu_has_skill_channel installer && skill_choice=yes
  install_dir=$(dirname "$WU_BIN")
  # Same route as the README install command. Nothing in it needs an answer:
  # the 4.1.9 clone choice is fixed to yes, the skill question is answered by
  # WECHAT_USE_INSTALL_SKILL (yes only when an installer-managed skill exists),
  # and the permission guide only appears when macOS permission is missing.
  INSTALL_DIR="$install_dir" WECHAT_USE_PREFER_419="${WECHAT_USE_PREFER_419:-yes}" \
    WECHAT_USE_INSTALL_SKILL="$skill_choice" bash "$installer" || status=$?
  rm -rf -- "$stage"
  if [[ "$status" != 0 ]]; then
    printf 'wechat-use upgrade: the installer stopped (exit %s); existing data and login are kept. Re-run: wechat-use upgrade\n' "$status" >&2
    return 1
  fi
  local after
  after=$(wu_current_version) || after="?"
  wu_write_cache "$(wu_now)" "$latest" || true
  printf '%s %s -> %s\n' "$WU_NAME" "$current" "$after"
  wu_refresh_skills 1 || return 1
  return 0
}

# Top-level help: the binary's help plus the launcher's `upgrade` command, so
# `wechat-use --help` (and the family upgrade script) can see it.
wu_help() {
  local out status=0
  out=$("$WU_BIN" "$@" 2>&1) || status=$?
  printf '%s\n' "$out" | awk '
    { print }
    /^Commands:/ && !done { print "  upgrade             升级 wechat-use CLI 与 skill（--check 只检查，--json 输出 JSON）"; done = 1 }'
  return "$status"
}

wu_main() {
  case "${1:-}" in
    upgrade) shift; wu_upgrade "$@"; return $? ;;
    -h|--help|help)
      if [[ $# -eq 1 ]]; then wu_help "$@"; return $?; fi
      if [[ "$1" == help && "${2:-}" == upgrade ]]; then wu_upgrade_usage; return 0; fi ;;
  esac
  wu_maybe_notice "$@"
  exec "$WU_BIN" "$@"
}

if [[ "${WECHAT_USE_LAUNCHER_LIB_ONLY:-0}" == 1 ]]; then
  # shellcheck disable=SC2317  # exit is reached only when executed, not sourced
  return 0 2>/dev/null || exit 0
fi
wu_main "$@"
